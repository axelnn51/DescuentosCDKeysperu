# ==========================================
# CONFIGURACIÓN DEL SPY DE REBAJAS PERÚ
# ==========================================

# 1. Token de tu bot de Telegram
TELEGRAM_BOT_TOKEN=TU_TELEGRAM_BOT_TOKEN_AQUI

# 2. ID del Chat, Canal o Grupo de Telegram
TELEGRAM_CHAT_ID=

# 3. Porcentaje mínimo de descuento para notificar
MIN_DISCOUNT_PERCENT=75

# 4. Intervalo de escaneo en minutos (Modo Daemon para Portainer)
SCAN_INTERVAL_MINUTES=15

# 5. Máximo de productos a analizar por tienda en cada escaneo
MAX_ITEMS_PER_STORE=50

# 6. Tiendas activas
ENABLED_STORES=plazavea,oechsle,metro,wong,promart,coolbox,footloose,triathlon,casaideas,sony,shopstar,lacuracao,efe,hiraoka,juntoz,ripley,falabella
