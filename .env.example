# ==========================================
# CONFIGURACIÓN DEL SPY DE REBAJAS PERÚ
# ==========================================

# 1. Token de tu bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_ejemplo

# 2. ID del Chat, Canal o Grupo de Telegram
# Para obtenerlo: envía /start a tu bot y ejecuta: python spy.py --get-chat-id
TELEGRAM_CHAT_ID=-1001234567890

# 3. Porcentaje mínimo de descuento para notificar (Por defecto: 50%)
MIN_DISCOUNT_PERCENT=50

# 4. Intervalo de escaneo en minutos (Modo Daemon para Portainer)
SCAN_INTERVAL_MINUTES=15

# 5. Máximo de productos a analizar por tienda en cada escaneo
MAX_ITEMS_PER_STORE=50

# 6. Tiendas activas
ENABLED_STORES=plazavea,oechsle,metro,wong,promart,coolbox,footloose,triathlon,casaideas,sony,shopstar,lacuracao,efe,hiraoka,juntoz,ripley,falabella,knasta
