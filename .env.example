# ==========================================
# CONFIGURACIÓN DEL SPY DE REBAJAS PERÚ
# ==========================================

# 1. Token de tu bot de Telegram (obtenido con @BotFather)
# Ejemplo: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# 2. ID del Chat, Canal o Grupo de Telegram
# Para canales públicos: @nombre_de_tu_canal
# Para chats privados o grupos: 123456789 o -1001234567890
TELEGRAM_CHAT_ID=

# 3. Porcentaje mínimo de descuento para notificar (Por defecto: 75%)
MIN_DISCOUNT_PERCENT=75

# 4. Intervalo de escaneo en minutos (Modo Daemon)
SCAN_INTERVAL_MINUTES=15

# 5. Máximo de productos a analizar por tienda en cada escaneo
MAX_ITEMS_PER_STORE=50

# 6. Tiendas activas (separadas por coma)
# Opciones disponibles: plazavea, oechsle, metro, wong, promart, coolbox, footloose, triathlon, casaideas, sony, ripley, falabella
ENABLED_STORES=plazavea,oechsle,metro,wong,promart,coolbox,footloose,triathlon,casaideas,sony,ripley,falabella
